FROM python:3.12-slim

WORKDIR /app

RUN pip install uv

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies using uv
RUN uv pip install --system --no-cache \
    aiohttp>=3.12.15 \
    complexipy>=4.2.0 \
    fastapi>=0.115.0 \
    pandas>=2.2.0 \
    playwright>=1.55.0 \
    python-jobspy>=1.1.82 \
    uvicorn>=0.34.0 \
    "tqdm>=4.66.0"

COPY src/ ./src/
COPY data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
